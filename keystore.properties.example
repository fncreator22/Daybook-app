# Copy this file to keystore.properties (same directory) and fill it in.
# keystore.properties is gitignored. Never commit the real one or the .jks file.
#
# Create the keystore once with:
#   keytool -genkeypair -v -keystore daybook-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias daybook
#
# Back the .jks file up somewhere safe. Losing it means you can never ship an
# update to the same Play listing unless you enrolled in Play App Signing.

storeFile=daybook-release.jks
storePassword=CHANGE_ME
keyAlias=daybook
keyPassword=CHANGE_ME

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Daybook requests no permissions at all.
      Everything is stored in the app's private database, and export/import
      goes through the Storage Access Framework, which grants per-file access
      without a storage permission. There is no INTERNET permission, so the
      app is provably incapable of sending your data anywhere.

      CAMERA: used only by the barcode wallet scanner (Phase 2). Requested
      at runtime when the user first opens the Wallet scan screen.

      INTERNET: required only for the optional Gemma 270M model download (Phase 3).
      The download is never triggered automatically — the user must explicitly opt in
      through the AI settings screen. ModelDownloader enforces a >250 MB free-space
      check and verifies the SHA-256 of the downloaded file before use.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      RECORD_AUDIO: used only by the voice agent button (Phase 6).
      SpeechRecognizer.createOnDeviceSpeechRecognizer() — fully on-device,
      Android 13+. Audio is never stored or sent anywhere.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />


    <application
        android:name=".DaybookApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Daybook"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Daybook"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share text from any app (Gmail, WhatsApp, browser) → Daybook NLP parser -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Phase 7 — WhatsApp Notification Reader (opt-in).
          NotificationListenerService is a privileged Android service; it requires the user to
          explicitly grant "Notification Access" in Android Settings → Apps → Special app access.
          The service does nothing until the user enables it in Daybook Settings AND grants
          Android-level Notification Access. It reads only notification title + text — the same
          text visible in the notification shade. No WhatsApp DB or chat history is accessed.
        -->
        <service
            android:name=".whatsapp.WhatsAppListenerService"
            android:exported="false"
            android:label="@string/whatsapp_reader_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
